# Copy to .env with ./scripts/server.sh init.
LSB_DB_ROOT_PASSWORD=replace-me
LSB_DB_PASSWORD=replace-me

# Safe default: only this Mac can reach the game ports and telemetry API.
# Change to a LAN address only after reading docs/architecture.md.
LSB_BIND_IP=127.0.0.1
LSB_ZONE_IP=127.0.0.1
FFXI_FORWARD_LISTEN_HOST=
LSB_ACCOUNT_CREATION=true

# Digests validated on 2026-07-25. Update intentionally after reviewing release
# notes and taking a database backup.
LSB_SERVER_IMAGE=ghcr.io/landsandboat/server@sha256:d502012d679b516924acaf31a31c2ccf6696b1490792833157a273b6ac7d2d83
LSB_MESH_IMAGE=ghcr.io/landsandboat/ximeshes@sha256:39558f676a18362581368cac19a1e54cd013a74e660767c1f3c6362ef1d2321f
LSB_DATABASE_IMAGE=mariadb@sha256:628f228f0fd5913a220438693576b29b6fe4dc1fa0a1298c0e98579fae28635f

# Scheduled backups are retained unless pruning is explicitly enabled. Copy
# verified backups off-host before enabling deletion.
FFXI_BACKUP_RETENTION_COUNT=30
FFXI_BACKUP_PRUNE=false
